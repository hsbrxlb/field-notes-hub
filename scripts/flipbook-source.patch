diff --git a/src/BookShell.tsx b/src/BookShell.tsx
new file mode 100644
index 0000000..7cae7ee
--- /dev/null
+++ b/src/BookShell.tsx
@@ -0,0 +1,141 @@
+import { useEffect, useMemo, useRef, useState, type ReactNode } from "react";
+import { createPortal } from "react-dom";
+import { PageFlip } from "../vendor/page-flip/dist/page-flip.js";
+import "../vendor/page-flip/dist/page-flip.css";
+
+type BookPosition = { index: number; portrait: boolean; state: string };
+
+export function BookShell({ title, children, onExit, suspended = false }: {
+  title: string; children: ReactNode[]; onExit: () => void; suspended?: boolean;
+}) {
+  const mountRef = useRef<HTMLDivElement>(null);
+  const engineRef = useRef<PageFlip | null>(null);
+  const backRef = useRef<HTMLButtonElement>(null);
+  const [attempt, setAttempt] = useState(0);
+  const [status, setStatus] = useState<"binding" | "ready" | "failed">("binding");
+  const [position, setPosition] = useState<BookPosition>({ index: 0, portrait: false, state: "read" });
+  // Engine owns leaf containers; React portals own their live content, never reparented React roots.
+  const leaves = useMemo(() => Array.from({ length: children.length }, () => {
+    const leaf = document.createElement("div");
+    leaf.className = "book-leaf";
+    leaf.dataset.density = "soft";
+    return leaf;
+  }), [children.length]);
+
+  useEffect(() => {
+    const mount = mountRef.current!;
+    const host = document.createElement("div");
+    host.className = "oedro-book";
+    mount.append(host);
+    const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
+    const engine = new PageFlip(host, {
+      width: 510, height: 680, size: "stretch" as NonNullable<ConstructorParameters<typeof PageFlip>[1]>["size"], minWidth: innerHeight < 480 ? 160 : 220, maxWidth: 540,
+      minHeight: 213, maxHeight: 720, maxShadowOpacity: .68, showCover: false,
+      usePortrait: true, autoSize: true, drawShadow: true, flippingTime: motion.matches ? 120 : 720,
+      startPage: 0, useMouseEvents: true, clickEventForward: true, swipeDistance: 42,
+      showPageCorners: true, disableFlipByClick: false, mobileScrollSupport: true, startZIndex: 10,
+    });
+    engineRef.current = engine;
+    let disposed = false;
+    let resizeFrame = 0;
+    let readyTimer = 0;
+    const sync = () => {
+      if (disposed || !engine.getPageCollection()) return;
+      const index = engine.getCurrentPageIndex();
+      const portrait = engine.getOrientation() === "portrait";
+      const state = engine.getState();
+      setPosition({ index, portrait, state });
+      leaves.forEach((leaf, i) => {
+        const visible = i === index || (!portrait && i === index + 1);
+        leaf.inert = !visible;
+        leaf.setAttribute("aria-hidden", String(!visible));
+      });
+    };
+    const updateMotion = () => { engine.getSettings().flippingTime = motion.matches ? 120 : 720; };
+    engine.on("flip", sync).on("changeOrientation", sync).on("changeState", sync);
+    engine.on("init", () => {
+      if (disposed) return;
+      clearTimeout(readyTimer);
+      sync();
+      setStatus("ready");
+    });
+    try {
+      engine.loadFromHTML(leaves);
+      readyTimer = window.setTimeout(() => setStatus("failed"), 2000);
+    } catch {
+      setStatus("failed");
+    }
+    const observer = new ResizeObserver(() => {
+      cancelAnimationFrame(resizeFrame);
+      resizeFrame = requestAnimationFrame(() => {
+        if (!disposed && engine.getPageCollection()) {
+          engine.getSettings().minWidth = innerHeight < 480 ? 160 : 220;
+          engine.cancelUserTouch(); engine.update(); sync();
+        }
+      });
+    });
+    observer.observe(mount);
+    motion.addEventListener("change", updateMotion);
+    backRef.current?.focus({ preventScroll: true });
+    return () => {
+      disposed = true;
+      clearTimeout(readyTimer);
+      cancelAnimationFrame(resizeFrame);
+      observer.disconnect();
+      motion.removeEventListener("change", updateMotion);
+      engine.destroy();
+      engineRef.current = null;
+    };
+  }, [leaves, attempt]);
+
+  const move = (direction: -1 | 1) => {
+    const engine = engineRef.current;
+    if (suspended || status !== "ready" || !engine || !["read", "fold_corner"].includes(engine.getState())) return;
+    engine.getSettings().flippingTime = window.matchMedia("(prefers-reduced-motion: reduce)").matches ? 120 : 720;
+    if (direction < 0 && engine.getCurrentPageIndex() > 0) engine.flipPrev();
+    if (direction > 0 && engine.getCurrentPageIndex() + (engine.getOrientation() === "portrait" ? 1 : 2) < children.length) engine.flipNext();
+  };
+
+  useEffect(() => {
+    if (suspended) { engineRef.current?.cancelUserTouch(); return; }
+    const onKey = (event: KeyboardEvent) => {
+      if (event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey) return;
+      const target = event.target as HTMLElement | null;
+      if (target?.closest('input, textarea, select, [contenteditable="true"], [role="dialog"]')) return;
+      if (event.key === "Escape") { event.preventDefault(); onExit(); }
+      if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
+        event.preventDefault();
+        if (!event.repeat) move(event.key === "ArrowLeft" ? -1 : 1);
+      }
+    };
+    window.addEventListener("keydown", onKey);
+    return () => window.removeEventListener("keydown", onKey);
+  });
+
+  const busy = !["read", "fold_corner"].includes(position.state);
+  return (
+    <main className={`book-room${busy ? " is-turning" : ""}`} data-page-index={position.index}
+      data-state={position.state} data-orientation={position.portrait ? "portrait" : "landscape"} inert={suspended}>
+      <button ref={backRef} className="experience-back" onClick={onExit} aria-label="Back to book selection">←</button>
+      <section className="book-stage" aria-label={title}>
+        <div className="book-stage__halo" aria-hidden="true" />
+        <div className="book-shadow" aria-hidden="true" />
+        <div className={`book-rig${status === "ready" ? " is-engine-ready" : ""}`}>
+          <div className="engine-mount" ref={mountRef} />
+          {status !== "ready" && <div className="book-loading" role="status">
+            {status === "binding" ? <><span />Loading pages…</> : <>
+              Pages could not load.
+              <button onClick={() => { setStatus("binding"); setAttempt(value => value + 1); }}>Retry</button>
+            </>}
+          </div>}
+        </div>
+      </section>
+      <nav className="book-controls" aria-label="Page navigation">
+        <button aria-label="Previous page" aria-disabled={busy || position.index === 0} onClick={() => move(-1)}>←</button>
+        <button aria-label="Next page" aria-disabled={busy || position.index + (position.portrait ? 1 : 2) >= children.length} onClick={() => move(1)}>→</button>
+      </nav>
+      <span className="sr-only" role="status" aria-live="polite">Page {position.index + 1} of {children.length}</span>
+      {children.map((child, i) => createPortal(child, leaves[i], String(i)))}
+    </main>
+  );
+}
