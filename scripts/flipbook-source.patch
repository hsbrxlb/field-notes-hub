+import { build } from 'esbuild';
+import { mkdir, writeFile } from 'node:fs/promises';
+import { createRequire } from 'node:module';
+import { dirname, join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { spawnSync } from 'node:child_process';
+
+const vendorRoot = dirname(fileURLToPath(import.meta.url));
+const require = createRequire(import.meta.url);
+const declarations = spawnSync(process.execPath, [
+  require.resolve('typescript/bin/tsc'),
+  '--project', join(vendorRoot, 'tsconfig.build.json'),
+], { cwd: vendorRoot, stdio: 'inherit' });
+if (declarations.error) throw declarations.error;
+if (declarations.status !== 0) process.exit(declarations.status ?? 1);
+
+await build({
+  absWorkingDir: vendorRoot,
+  entryPoints: ['src/PageFlip.ts'],
+  outfile: 'dist/page-flip.js',
+  bundle: true,
+  format: 'esm',
+  platform: 'browser',
+  target: ['es2022'],
+  sourcemap: true,
+  legalComments: 'linked',
+});
+await mkdir(join(vendorRoot, 'dist'), { recursive: true });
+await writeFile(join(vendorRoot, 'dist', 'page-flip.d.ts'),
+  '// Generated by ../build.mjs; declarations use upstream-compatible null checking.\n' +
+  'export { PageFlip } from "./types/PageFlip";\n');
+console.log('Built local page-flip JS, CSS, source maps, and declarations.');
