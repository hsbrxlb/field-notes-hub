+
+/* Leave real space for controls; size display type from the leaf, not the viewport. */
+.book-room { height: 100dvh; min-height: 0; padding: 68px 12px 60px; }
+.book-stage { width: 100%; }
+.book-rig { width: min(90vw, calc((100dvh - 132px) * 1.5), 1080px); }
+.engine-mount { width: 100%; }
+.leaf-content { width: 100%; height: 100%; }
+.book-leaf { container-type: inline-size; }
+.editorial-page h2 { font-size: clamp(26px, 11.5cqw, 64px); }
+.question-page h2 { font-size: clamp(25px, 10.5cqw, 60px); }
+.research-back h2 { font-size: clamp(28px, 12cqw, 68px); }
+.editorial-page__content .brand-mark { width: 24%; }
+.editorial-page__eyebrow { margin: 18px 0 12px; }
+.editorial-page__body { margin-top: 14px; }
+.editorial-page__folio { display: none; }
+.book-controls { position: absolute; bottom: 8px; left: 50%; transform: translateX(-50%); display: flex; gap: 24px; }
+.book-controls button, .book-loading button { min-width: 44px; min-height: 44px; border: 1px solid var(--line-light); background: var(--ink); color: var(--paper); cursor: pointer; }
+.book-controls button { border-radius: 50%; }
+.book-controls button[aria-disabled="true"] { opacity: .35; cursor: default; }
+.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
+.sheet-close { width: 44px; height: 44px; }
+.response-sheet { height: 100dvh; overscroll-behavior: contain; }
+.book-leaf, .engine-mount { touch-action: pan-y pinch-zoom; }
+@media (max-width: 720px) {
+  .book-rig { width: min(92vw, calc((100dvh - 132px) * .75)); }
+}
+@media (max-height: 600px) {
+  .editorial-page__content { padding: 6%; }
+  .editorial-page h2, .question-page h2 { font-size: clamp(23px, 9cqw, 36px); }
+  .question-page__meta { margin-top: 12px; padding-bottom: 8px; }
+  .question-page p { margin-bottom: 12px; }
+  .placement-top-left.question-page h2 { margin-top: 16px; }
+}
+@media (max-height: 480px) {
+  .editorial-page__content .brand-mark, .question-page__meta, .editorial-page__eyebrow { display: none; }
+  .editorial-page h2, .question-page h2 { font-size: clamp(20px, 9cqw, 28px); }
+  .question-page button { min-height: 44px; padding-block: 8px; }
+  .question-page p { margin-bottom: 8px; }
+  .placement-top-left.question-page h2 { margin-top: 0; }
+  .research-back { padding: 7%; }
+  .research-back p { display: none; }
+  .research-back h2 { margin: 0 0 12px; font-size: clamp(22px, 10cqw, 36px); }
+  .research-back span { line-height: 1.35; }
+}
