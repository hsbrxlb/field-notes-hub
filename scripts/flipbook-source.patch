+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { build } from 'esbuild';
+import { fileURLToPath } from 'node:url';
+
+const root = fileURLToPath(new URL('.', import.meta.url));
+const result = await build({
+  stdin: { contents: `export { Flip } from './src/Flip/Flip'; export { Render } from './src/Render/Render'; export { UI } from './src/UI/UI'; export { PageCollection } from './src/Collection/PageCollection'; export { PageFlip } from './src/PageFlip';`, resolveDir: root },
+  bundle: true, write: false, format: 'cjs', platform: 'node', loader: { '.css': 'empty' },
+});
+const module = { exports: {} };
+new Function('module', 'exports', result.outputFiles[0].text)(module, module.exports);
+const { Flip, Render, UI, PageCollection, PageFlip } = module.exports;
+globalThis.window = { navigator: { userAgent: 'unit-test' }, addEventListener() {}, removeEventListener() {} };
+
+test('odd last leaf preserves soft material', () => {
+  class Collection extends PageCollection { load() {} }
+  const collection = new Collection({ getSettings: () => ({ showCover: false }) }, {});
+  collection.pages = Array.from({ length: 7 }, () => ({ density: 'soft', setDensity(value) { this.density = value; } }));
+  collection.createSpread();
+  assert.equal(collection.pages[6].density, 'soft');
+  assert.deepEqual(collection.landscapeSpread, [[0, 1], [2, 3], [4, 5], [6]]);
+});
+
+function controller(index = 0) {
+  let cancels = 0;
+  let shown = 0;
+  const render = {
+    getRect: () => ({ width: 1000, height: 680, pageWidth: 500 }),
+    getOrientation: () => 'landscape', convertToBook: (p) => p,
+    cancelAnimation: () => cancels++, setBottomPage() {}, setFlippingPage() {}, clearShadow() {},
+  };
+  const app = { getCurrentPageIndex: () => index, getPageCount: () => 7,
+    getPageCollection: () => ({ getPages: () => [], show: () => shown++ }), updateState() {},
+    getSettings: () => ({ disableFlipByClick: false }) };
+  return { flip: new Flip(render, app), counts: () => ({ cancels, shown }) };
+}
+
+test('first-back and final-forward drag failures return to read', () => {
+  for (const [index, x] of [[0, 2], [6, 998]]) {
+    const { flip } = controller(index);
+    flip.fold({ x, y: 650 });
+    flip.stopMove();
+    assert.equal(flip.getState(), 'read');
+  }
+});
+
+test('cancellation discards pending commit and rapid flips do not interrupt settling', () => {
+  const { flip, counts } = controller();
+  flip.state = 'flipping';
+  flip.flip({ x: 998, y: 650 });
+  assert.equal(counts().cancels, 0);
+  flip.cancel();
+  assert.equal(flip.getState(), 'read');
+  assert.deepEqual(counts(), { cancels: 1, shown: 1 });
+});
+
+test('render destruction cancels its RAF and animation callback', () => {
+  let callback;
+  let cancelled;
+  globalThis.requestAnimationFrame = (fn) => { callback = fn; return 31; };
+  globalThis.cancelAnimationFrame = (id) => { cancelled = id; };
+  class Renderer extends Render { update() {} drawFrame() { throw new Error('rendered after destroy'); } }
+  const render = new Renderer({}, {});
+  render.start();
+  render.animation = { onAnimateEnd: () => { throw new Error('committed after destroy'); } };
+  render.destroy();
+  assert.equal(cancelled, 31);
+  callback(100);
+  assert.equal(render.animation, null);
+});
+
+test('touch vertical intent does not start a fold; cancellation clears tracking', () => {
+  const calls = [];
+  const element = { classList: { add() {} }, style: {}, insertAdjacentHTML() {}, querySelector() { return this; }, getBoundingClientRect: () => ({ left: 0, top: 0 }) };
+  const settings = { usePortrait: true, minWidth: 220, minHeight: 293, swipeDistance: 42, clickEventForward: true };
+  const app = { getSettings: () => settings, getState: () => 'read', startUserTouch: () => calls.push('start'), userMove: () => calls.push('move'), userStop: () => calls.push('stop'), cancelUserTouch() { ui.cancelPendingTouch(); calls.push('cancel'); } };
+  class TestUI extends UI { constructor() { super(element, app, settings); this.distElement = element; } update() {} }
+  const ui = new TestUI();
+  const event = (x, y) => ({ target: { closest: () => null }, touches: [{ identifier: 1 }], changedTouches: [{ identifier: 1, clientX: x, clientY: y }], cancelable: true, preventDefault() {} });
+  ui.onTouchStart(event(200, 200));
+  ui.onTouchMove(event(220, 270));
+  ui.onTouchEnd(event(245, 280));
+  assert.deepEqual(calls, []);
+  ui.onTouchStart(event(200, 200));
+  ui.onTouchMove(event(160, 205));
+  assert.deepEqual(calls, ['start', 'move']);
+  ui.onCancel();
+  assert.equal(ui.touchPoint, null);
+});
+
+test('destroy before initialization is idempotent and cancels init callback', async () => {
+  let removed = 0;
+  let fired = false;
+  const app = new PageFlip({ remove: () => removed++ }, { width: 510, height: 680 });
+  app.initTimer = setTimeout(() => { fired = true; }, 5);
+  app.destroy();
+  app.destroy();
+  await new Promise((resolve) => setTimeout(resolve, 15));
+  assert.equal(removed, 1);
+  assert.equal(fired, false);
+});
