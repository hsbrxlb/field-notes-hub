  "family_notes": {
    "badger": "低位检修与耐脏耐磨；重点看楔形头、宽背和贴近地面的动作。",
    "mule": "承重、拖带和把重活做完；重点看长耳、方正胸腔与四蹄受力。",
    "gecko": "贴合、窄缝安装和准确落位；重点看扁头、趾垫和尾巴形成的负形。",
    "raven": "高处巡检与发现异常；重点看长喙、大翼面和落地前后的动作节奏。",
    "armadillo-flex": "柔性保护与越野耐用；重点看五段软壳在展开、收拢和低位通过时的表现。",
    "copilot-dog": "沉稳、可靠、愿意同行；用宽阔胸肩、专注眼神和自然动作建立亲和力。",
    "canyon-fox": "敏锐但不狡黠；用长耳、披肩与清楚的尾部弧线形成优雅轮廓。",
    "quiet-lynx": "克制、精准、有审美；用耳簇、短尾和利落工装保持安静的专业感。",
    "kestrel-scout": "轻盈、警觉、视野开阔；用翼面、俯冲和落点变化表达路线侦察。",
    "route-engineer": "把专业能力变成可信的人格；用成熟比例、真实工装和明确动作呈现服务感。"
  }
